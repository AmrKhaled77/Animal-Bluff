{
  "name": "@animal-bluff/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test dist/rooms.test.js dist/game-engine.test.js dist/game-service.test.js dist/rate-limiter.test.js dist/realtime-room.test.js",
    "test:integration": "npm run build && node --test dist/integration.test.js",
    "db:generate": "prisma generate --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@animal-bluff/shared": "0.1.0",
    "@colyseus/core": "0.16.19",
    "@colyseus/ws-transport": "0.16.5",
    "@prisma/client": "6.19.0",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "prisma": "6.19.0",
    "tsx": "4.20.3"
  }
}
