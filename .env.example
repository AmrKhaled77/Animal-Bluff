# PostgreSQL connection used by Prisma (replace locally; never commit credentials).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/animal_bluff?schema=public"

# Backend HTTP and WebSocket listener.
SERVER_HOST="127.0.0.1"
SERVER_PORT="2567"

# Browser origin allowed by the backend's CORS policy.
WEB_ORIGIN="http://localhost:3000"
